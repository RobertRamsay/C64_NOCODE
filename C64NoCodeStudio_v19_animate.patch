+    array_push(L, "au_out:", " ldy an_e", " lda en_flo,y", " sta au_fr+1", " lda en_fhi,y", " sta au_fr+2", " ldy as_f,x");
+    array_push(L, "au_fr:", " lda $ffff,y", " sec", " rts");
