+            array_push(_rh, "0");
+        }
+    }
+    array_push(L, "cm_on:", " .byte " + string_join_ext(",", _on), "cm_flags:", " .byte " + string_join_ext(",", _fl), "cm_n:", " .byte " + string_join_ext(",", _n));
+    array_push(L, "cm_rlo:", " .byte " + string_join_ext(",", _rl), "cm_rhi:", " .byte " + string_join_ext(",", _rh));
