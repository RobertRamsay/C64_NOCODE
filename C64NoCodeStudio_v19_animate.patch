diff --git a/C64NoCode/scripts/scr_ws_animate/scr_ws_animate.gml b/C64NoCode/scripts/scr_ws_animate/scr_ws_animate.gml
new file mode 100644
index 0000000..7b907eb
--- /dev/null
+++ b/C64NoCode/scripts/scr_ws_animate/scr_ws_animate.gml
@@ -0,0 +1,919 @@
+/// C64 NO-CODE STUDIO - Animate page (ADAM's): Idle, Walk, Jump and Fall animations of up to
+/// 16 frames for each cast member, or the 8 joystick directions, and Fire animations for the
+/// player - with a test mode driven by the arrow keys, WASD or a gamepad.
+/// Data, plans and the 6502 player are in scr_anim.
+
+
+/// The cast member the page is on
+function anim_cur_item()
+{
+    var _cast = anim_cast(proj);
+    if (array_length(_cast) == 0) { return undefined; }
+    anim_cast_sel = clamp(anim_cast_sel, 0, array_length(_cast) - 1);
+    return _cast[anim_cast_sel];
+}
+
+/// Marks an undo step; the first change starts from the member's Sprites page animation
+function anim_begin_edit(_it, _tag)
+{
+    undo_mark(_tag);
+    anim_seed_from_legacy(_it);
+    anim_t0 = current_time;
+}
+
+/// True on the second click of a double-click on control _id (within 0.4 s)
+function anim_dbl(_id)
+{
+    if (anim_click_id == _id && current_time - anim_click_time < 400)
+    {
+        anim_click_id = "";
+        return true;
+    }
+    anim_click_id = _id;
+    anim_click_time = current_time;
+    return false;
+}
+
+/// Opens sprite _i on the Sprites page to draw it
+function anim_edit_sprite(_i)
+{
+    spr_sel = clamp(_i, 0, SPR_COUNT - 1);
+    ws_set(WS_SPRITES);
+}
+
+/// Ticks (machine frames) since _t0
+function anim_ticks(_t0)
+{
+    return floor((current_time - _t0) * sid_fps() / 1000);
+}
+
+/// The background colour sprites are seen on
+function anim_bg()
+{
+    if (proj.game_type == 1) { return c64col(proj.eng.bg); }
+    return c64col(proj.background);
+}
+
+/// Input for test mode: keyboard (arrows / WASD, fire Space / Ctrl) or any gamepad
+/// (stick / d-pad, fire A). Returns [dx, dy, fire].
+function anim_test_input(_source)
+{
+    var _dx = 0;
+    var _dy = 0;
+    var _fire = false;
+    if (_source == 0 && ui_focus == "")
+    {
+        if (keyboard_check(vk_space) || keyboard_check(vk_control)) { _fire = true; }
+        if (keyboard_check(vk_left) || keyboard_check(ord("A"))) { _dx -= 1; }
+        if (keyboard_check(vk_right) || keyboard_check(ord("D"))) { _dx += 1; }
+        if (keyboard_check(vk_up) || keyboard_check(ord("W"))) { _dy -= 1; }
+        if (keyboard_check(vk_down) || keyboard_check(ord("S"))) { _dy += 1; }
+    }
+    if (_source == 1)
+    {
+        for (var g = 0; g < 12; g++)
+        {
+            if (!gamepad_is_connected(g)) { continue; }
+            var _ax = gamepad_axis_value(g, gp_axislh);
+            var _ay = gamepad_axis_value(g, gp_axislv);
+            var _pad_x = 0;
+            var _pad_y = 0;
+            if (gamepad_button_check(g, gp_padl)) { _pad_x -= 1; }
+            if (gamepad_button_check(g, gp_padr)) { _pad_x += 1; }
+            if (gamepad_button_check(g, gp_padu)) { _pad_y -= 1; }
+            if (gamepad_button_check(g, gp_padd)) { _pad_y += 1; }
+            if (_pad_x == 0 && _pad_y == 0)
+            {
+                if (abs(_ax) > 0.4) { _pad_x = sign(_ax); }
+                if (abs(_ay) > 0.4) { _pad_y = sign(_ay); }
+            }
+            var _pad_fire = gamepad_button_check(g, gp_face1);
+            if (_pad_x != 0 || _pad_y != 0 || _pad_fire)
+            {
+                _dx = _pad_x;
+                _dy = _pad_y;
+                _fire = _pad_fire;
+                break;
+            }
+        }
+    }
+    return [clamp(_dx, -1, 1), clamp(_dy, -1, 1), _fire];
+}
+
+/// Direction 0..7 (N NE E SE S SW W NW) of a move
+function anim_dir_of(_dx, _dy)
+{
+    if (_dy < 0)
+    {
+        if (_dx < 0) { return 7; }
+        if (_dx > 0) { return 1; }
+        return 0;
+    }
+    if (_dy > 0)
+    {
+        if (_dx < 0) { return 5; }
+        if (_dx > 0) { return 3; }
+        return 4;
+    }
+    if (_dx < 0) { return 6; }
+    if (_dx > 0) { return 2; }
+    return 0;
+}
+
+/// Draws plan entry _k playing live in a square _w wide. A direction without an entry
+/// of its own plays Walk, as the game does.
+function anim_slot_preview(_plan, _k, _x, _y, _w, _col, _alpha, _ticks, _face_dir, _replay_once)
+{
+    if (is_undefined(_plan)) { return; }
+    var _kk = _k;
+    if (_kk >= array_length(_plan))
+    {
+        if (_kk >= ANIM_FIRE0) { return; }
+        _kk = 1;
+    }
+    var _e = _plan[_kk];
+    if (_e.mode == 3 && array_length(_plan) > ANIM_DIR0 + _face_dir)
+    {
+        _e = _plan[ANIM_DIR0 + _face_dir];
+        _ticks = 0;
+    }
+    anim_strip_preview(_e.frames, _e.rate, _e.mode, _e.flip, _x, _y, _w, _col, _alpha, _ticks, _replay_once);
+}
+
+/// Draws frames _frames playing live (rate, mode, turned round) in a square _w wide.
+/// Once replays after a short pause, so a preview never stops for good.
+function anim_strip_preview(_frames, _rate, _mode, _flip, _x, _y, _w, _col, _alpha, _ticks, _replay_once)
+{
+    var _n = array_length(_frames);
+    if (_n == 0) { return; }
+    var _md = _mode;
+    if (_md == 3) { _md = 0; }
+    if (_md == 1 && _replay_once) { _ticks = _ticks mod (_n * max(2, _rate) + 30); }
+    var _fi = anim_frame_at({ frames : _frames, rate : _rate, mode : _md }, _ticks);
+    var _si = clamp(_frames[_fi], 0, SPR_COUNT - 1);
+    var _sc = (_w - 8) / 24;
+    draw_sprite_c64_flip(_si, _x + (_w - 24 * _sc) / 2, _y + (_w - 21 * _sc) / 2, _sc, _flip, _col, _alpha);
+}
+
+/// Grid cell (-1..1, -1..1) of direction 0..7
+function anim_dir_cell(_d)
+{
+    var _gx = [0, 1, 1, 1, 0, -1, -1, -1];
+    var _gy = [-1, -1, 0, 1, 1, 1, 0, -1];
+    return [_gx[_d], _gy[_d]];
+}
+
+/// Copies an animation into entry _k of the member on the page (a drop from the library or another slot)
+function anim_drop_into(_it, _k, _frames, _rate, _mode)
+{
+    if (_k < 0 || _k >= ANIM_COUNT) { return; }
+    anim_begin_edit(_it, "animdrop" + string(current_time));
+    var _fr = [];
+    for (var f = 0; f < min(array_length(_frames), ANIM_FRAMES); f++) { array_push(_fr, _frames[f]); }
+    var _m = _mode;
+    if (_m == 3) { _m = 0; }
+    _it.h.anims[_k] = { frames : _fr, rate : clamp(_rate, 2, 30), mode : clamp(_m, 0, 2) };
+    anim_sel = _k;
+    anim_slot = 0;
+    anim_t0 = current_time;
+    var _ln = anim_long_names();
+    toast(_ln[_k] + ": " + string(array_length(_fr)) + " frames dropped in", 0);
+}
+
+/// Starts dragging an animation once the mouse has moved a little with the button held;
+/// _src = the joystick slot it came from (-1 = library)
+function anim_drag_arm(_frames, _rate, _mode, _flip, _col, _label, _src)
+{
+    anim_drag_armed = true;
+    anim_drag_on = false;
+    anim_drag_x0 = ui_mx;
+    anim_drag_y0 = ui_my;
+    anim_drag_frames = _frames;
+    anim_drag_rate = _rate;
+    anim_drag_mode = _mode;
+    anim_drag_flip = _flip;
+    anim_drag_col = _col;
+    anim_drag_label = _label;
+    anim_drag_src = _src;
+}
+
+/// Marks entry _k as the drop target while an animation is dragged over it
+function anim_drop_zone(_k, _x1, _y1, _x2, _y2)
+{
+    if (!anim_drag_on || _k == anim_drag_src) { return; }
+    if (point_in_rectangle(ui_mx, ui_my, _x1, _y1, _x2, _y2))
+    {
+        anim_drop_k = _k;
+        ui_rrect_line(_x1 - 3, _y1 - 3, _x2 + 3, _y2 + 3, 10, global.TH.accent, 1, 3);
+    }
+    else
+    {
+        ui_rrect_line(_x1 - 1, _y1 - 1, _x2 + 1, _y2 + 1, 9, global.TH.accent, 0.35 + 0.25 * sin(current_time / 120), 1);
+    }
+}
+
+/// One joystick seen from above: _which 0 = Moving (Idle in the middle, the 8 directions
+/// round it), 1 = With Fire. Each slot plays its animation live; click to pick it, drag to copy it.
+function anim_joystick(_which, _x, _y, _size, _it, _plan, _in, _test_k)
+{
+    var _gap = 6;
+    var _cell = floor((_size - 4 * _gap) / 3);
+    var _cx = _x + _size / 2;
+    var _cy = _y + _size / 2;
+    var _k0 = 0;
+    var _kd = ANIM_DIR0;
+    if (_which == 1)
+    {
+        _k0 = ANIM_FIRE0;
+        _kd = ANIM_FIRE0 + 1;
+    }
+    var _test_dir_k = -1;
+    if (anim_test && (_in[0] != 0 || _in[1] != 0))
+    {
+        if ((_which == 0 && !_in[2]) || (_which == 1 && _in[2])) { _test_dir_k = _kd + anim_dir_of(_in[0], _in[1]); }
+    }
+    var _lnames = anim_long_names();
+    ui_rrect(_x, _y + 3, _x + _size, _y + _size + 3, 18, c_black, c_black, 0.35);
+    ui_rrect(_x, _y, _x + _size, _y + _size, 18, make_colour_rgb(58, 62, 72), make_colour_rgb(30, 32, 38), 1);
+    ui_rrect_line(_x, _y, _x + _size, _y + _size, 18, global.TH.panel_edge, 0.8, 1);
+    var _hot_any = false;
+    var _bg = anim_bg();
+    for (var d = 0; d < 9; d++)
+    {
+        var _k = _k0;
+        var _gcx = 0;
+        var _gcy = 0;
+        if (d < 8)
+        {
+            _k = _kd + d;
+            var _gc = anim_dir_cell(d);
+            _gcx = _gc[0];
+            _gcy = _gc[1];
+        }
+        var _sx = _cx + _gcx * (_cell + _gap) - _cell / 2;
+        var _sy = _cy + _gcy * (_cell + _gap) - _cell / 2;
+        var _id = "anim_dir_" + string(_k);
+        var _help = _lnames[_k] + "|Plays live here. Click to give this direction its own frames, drag it to copy it to another slot, or drop an animation from the library on it. Empty directions borrow from the others (turned round when 'Turn to face left' is on), or from Walk.";
+        if (_which == 1) { _help = _lnames[_k] + "|Plays while the player holds fire and pushes this way - shooting, digging, swinging. Drag to copy it, or drop an animation from the library on it. Empty: it borrows from the other Fire directions."; }
+        if (d == 8)
+        {
+            _id = "anim_mid_" + string(_which);
+            _help = "Idle|Plays while it stands still. Click to edit it, drag it to copy it, or drop an animation on it. Empty: it stands facing the way it last moved (with directions), or plays Walk.";
+            if (_which == 1) { _help = "Fire|Plays while the player holds fire without pushing a direction. Click to edit it, or drop an animation on it. Empty: it uses a Fire direction, or the normal animation."; }
+        }
+        var _hot = ui_register(_id, _sx, _sy, _sx + _cell, _sy + _cell, _help);
+        if (_hot && d < 8 && !anim_drag_on) { _hot_any = true; }
+        if (_hot && ui_pressed)
