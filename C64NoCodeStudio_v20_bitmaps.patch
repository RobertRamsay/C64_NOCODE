+            var _t = array_create(_n, 0);
+            var _rx = _mc ? max(1, _rad div 2) : _rad;
+            for (var yy = 0; yy < 200; yy++)
+            {
+                for (var xx = 0; xx < _W; xx++)
+                {
+                    var _s = 0;
+                    var _k = 0;
+                    for (var d = -_rx; d <= _rx; d++)
