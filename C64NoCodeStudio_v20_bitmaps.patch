+    surface_set_target(_s2);
+    draw_clear_alpha(c_black, 1);
+    draw_surface_ext(_s1, 0, 0, _W / 320, 1, 0, c_white, 1);
+    surface_reset_target();
+    gpu_set_texfilter(_tf);
