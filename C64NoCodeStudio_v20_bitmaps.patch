+// ---------------------------------------------------------------------------
+// Bitmaps: new, import, duplicate, delete
+// ---------------------------------------------------------------------------
+
+function bm_add(_b)
+{
+    if (array_length(proj.pictures) >= BMP_MAX)
+    {
+        toast("You have " + string(BMP_MAX) + " bitmaps - delete one first", 1);
