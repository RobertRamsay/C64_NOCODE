+                    var _byte = 0;
+                    for (var p = 0; p < 4; p++)
+                    {
+                        var _v = _px[(cy * 8 + r) * _w + cx * 4 + p];
+                        var _bits = 0;
+                        if (_v == _b.bg) { _bits = 0; }
+                        else if (_v == _c1) { _bits = 1; }
+                        else if (_v == _c2) { _bits = 2; }
+                        else if (_v == _c3) { _bits = 3; }
+                        else
+                        {
