+    bm_imp.pic.mode = bm_imp.set.mode;
+    bm_imp.pic.bg = _r.bg;
+    bm_imp.pic.pix = _r.pix;
+    bm_imp.dirty = false;
+}
+
+function bm_import_finish()
+{
+    bm_import_step();
+    var _p = bm_imp.pic;
+    var _b = { name : bm_imp.name, mode : _p.mode, bg : _p.bg, border : 0, pix : _p.pix };
