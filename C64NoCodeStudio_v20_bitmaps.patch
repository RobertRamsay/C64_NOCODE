+                    if (_cnt[k] > _bn) { _bn = _cnt[k]; _bk = k; }
+                }
+                if (_bk < 0) { break; }
+                array_push(_order, _bk);
+                _cnt[_bk] = 0;
+            }
+            if (_mc)
+            {
+                var _c1 = (array_length(_order) > 0) ? _order[0] : 0;
+                var _c2 = (array_length(_order) > 1) ? _order[1] : _c1;
+                var _c3 = (array_length(_order) > 2) ? _order[2] : _c1;
+                _scr[_cell] = (_c1 << 4) | _c2;
+                _col[_cell] = _c3;
