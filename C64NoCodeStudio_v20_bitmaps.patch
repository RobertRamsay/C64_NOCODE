+        var _eb = array_create(_n, 0);
+        var _fs = (_st.dither == 5);
+        for (var py = 0; py < 200; py++)
+        {
+            for (var px = 0; px < _W; px++)
+            {
+                var _k3 = py * _W + px;
+                var _r2 = clamp(_R[_k3] + _er[_k3], 0, 255);
+                var _g2 = clamp(_G[_k3] + _eg[_k3], 0, 255);
