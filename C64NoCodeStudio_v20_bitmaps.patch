+        {
+            bm_line(_b, bm_lx, bm_ly, _cmx, _cmy, _col2);
+            bm_lx = _cmx;
+            bm_ly = _cmy;
+        }
+        if (!_down)
+        {
+            // let go: shapes are drawn now
+            switch (bm_tool)
+            {
+                case BM_BRUSH:
+                    bm_commit(_b);
+                    bm_last_x = bm_lx;
+                    bm_last_y = bm_ly;
+                    break;
+                case BM_LINE:
+                    undo_mark("bmline" + string(current_time));
+                    bm_line(_b, bm_ax, bm_ay, _cmx, _cmy, _col2);
+                    bm_commit(_b);
+                    break;
+                case BM_BOX:
+                    undo_mark("bmbox" + string(current_time));
