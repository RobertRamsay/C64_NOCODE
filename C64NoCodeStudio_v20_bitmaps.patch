+    {
+        var _r = bmp_load_c64_file(_f);
+        if (is_string(_r))
+        {
+            toast(_r, 2);
+            return;
+        }
+        if (bm_add(_r)) { toast(filename_name(_f) + " imported", 0); }
+        return;
+    }
+    bm_import_cancel();
+    var _spr = sprite_add(_f, 1, false, false, 0, 0);
+    if (_spr < 0)
+    {
+        toast("Could not load that picture", 2);
+        return;
+    }
