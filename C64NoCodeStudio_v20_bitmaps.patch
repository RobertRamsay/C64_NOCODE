+    for (var i = 0; i < 8000; i++) { buffer_poke(_d, 2 + i, buffer_u8, _e.bmp[i]); }
+    for (var k = 0; k < 1000; k++) { buffer_poke(_d, 8002 + k, buffer_u8, _e.scr[k]); }
+    if (_mc)
+    {
+        for (var c = 0; c < 1000; c++) { buffer_poke(_d, 9002 + c, buffer_u8, _e.col[c]); }
