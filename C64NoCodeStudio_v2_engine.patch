+/// Draws a 16x16 shape into 4 consecutive chars of the charset
+function tpl_tile_gfx(_p, _code, _shape)
+{
+    for (var q = 0; q < 4; q++)
+    {
+        var _ox = (q mod 2) * 8;
+        var _oy = (q div 2) * 8;
+        for (var r = 0; r < 8; r++)
+        {
+            var _b = 0;
+            for (var b = 0; b < 8; b++)
+            {
+                if (tpl_shape(_shape, _ox + b, _oy + r)) { _b = _b | (128 >> b); }
+            }
+            _p.charset[(_code + q) * 8 + r] = _b;
+        }
+    }
+}
