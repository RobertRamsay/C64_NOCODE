     {"$GMIncludedFile":"","%Name":"Poppins-Bold.ttf","CopyToMask":-1,"filePath":"datafiles/fonts","name":"Poppins-Bold.ttf","resourceType":"GMIncludedFile","resourceVersion":"2.0",},
     {"$GMIncludedFile":"","%Name":"Poppins-OFL.txt","CopyToMask":-1,"filePath":"datafiles/fonts","name":"Poppins-OFL.txt","resourceType":"GMIncludedFile","resourceVersion":"2.0",},
