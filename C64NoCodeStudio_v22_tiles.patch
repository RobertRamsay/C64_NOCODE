+; ---------- dig and place (Tiles page, ported from ADAM) ----------
+; fire + a direction digs the tile that way (held for its dig time), fire on its own
+; puts the tile carried down in front; while fire is held the player stands still
+    .if DIG_PLACE
+dig_place:
+    lda joy
+    and #16
+    bne dp_f
+    sta dp_last
+    sta dp_cnt
+    rts
+dp_f:
+    lda joy
+    and #15
+    sta dp_dirs
+    lda #16
+    sta joy
+    lda dp_dirs
+    bne dp_dig
+    lda dp_last
+    bne dp_rt
+    lda #1
+    sta dp_last
+    jmp dp_put
+dp_rt:
+    rts
+dp_dig:
+    lda #1
+    sta dp_last
+    ldx #0
+    ldy #11
+    lda dp_dirs
+    and #4
+    beq dp_d1
+    lda #4
+    bne dp_pt
+dp_d1:
+    lda dp_dirs
+    and #8
+    beq dp_d2
+    lda #19
+    bne dp_pt
+dp_d2:
+    ldy #2
+    lda dp_dirs
+    and #1
+    bne dp_d3
+    ldy #21
+dp_d3:
+    lda #12
+dp_pt:
+    jsr ent_point
+    lda t3
+    bmi dp_no
+    jsr tile_at
+    and #A_DIG
+    beq dp_no
+    lda t4
+    cmp dp_cx
+    bne dp_new
+    lda t5
+    cmp dp_cy
+    bne dp_new
+    inc dp_cnt
+    lda dp_cnt
+    cmp thard,x
+    bcc dp_r
+    stx dp_t
+    lda tbecome,x
+    jsr set_tile
+    ldx dp_t
+    jsr collect_tile
+    lda dp_t
+    cmp carry_t
+    beq dp_inc
+    sta carry_t
+    lda #0
+    sta carry_n
+dp_inc:
+    lda carry_n
+    cmp #99
+    bcs dp_no
+    inc carry_n
+dp_no:
+    lda #0
+    sta dp_cnt
+    lda #$ff
+    sta dp_cx
+dp_r:
+    rts
+dp_new:
+    lda t4
+    sta dp_cx
+    lda t5
+    sta dp_cy
+    lda #0
+    sta dp_cnt
+    rts
+; the tile carried goes in front of the player, into an empty cell
+dp_put:
+    lda carry_n
+    beq dp_r2
+    lda e_dir
+    and #7
+    tay
+    lda dp_py,y
+    sta t6
+    lda dp_px,y
+    ldy t6
+    ldx #0
+    jsr ent_point
+    lda t3
+    bmi dp_r2
+    jsr tile_at
+    and #A_SOLID
+    bne dp_r2
+    cpx #0
+    bne dp_r2
+    lda t5
+    cmp map_h
+    bcs dp_r2
+    lda carry_t
+    jsr set_tile
+    dec carry_n
+    ldx carry_t
+    lda tsfx,x
+    jmp play_sfx
+dp_r2:
+    rts
+; the point in front of the player for each direction (up, up-right, right ... up-left)
+dp_px: .byte 12,19,19,19,12,4,4,4
+dp_py: .byte 2,11,11,11,21,11,11,11
+    .endif
