+    array_push(L, " lda sfxt_fc,y", " sta flt_c", " sta $d416", " lda #0", " sta $d415", " lda sfxt_fsw,y", " sta flt_s");
+    array_push(L, " lda sfxt_len,y", " clc", " adc #25", " sta flt_t", " jmp sidp_g");
