+    array_push(L, " lda flt_t", " beq sidu_r", " dec flt_t", " lda flt_s", " beq sidu_r", " bmi sidu_fn");
+    array_push(L, " clc", " adc flt_c", " bcc sidu_fs", " lda #255", " jmp sidu_fs");
+    array_push(L, "sidu_fn:", " clc", " adc flt_c", " bcs sidu_fs", " lda #0");
