+        var _v2 = ui_dropdown("mus_lvl_0", _x1 + 28 + ceil(ui_sw("Your game's screen")), _y, 220, 30, _opts, proj.level_song[0] + 1, "Screen music|The song that starts with the game (and again after game over).");
