+        draw_set_alpha(1);
+        draw_rectangle_colour(_gx + _hx * _cw, _gy + _hy * _ps, _gx + _hx * _cw + _cw - 1, _gy + _hy * _ps + _ps - 1, c_white, c_white, c_white, c_white, true);
