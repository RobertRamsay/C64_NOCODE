+    build_show_asm = ui_toggle("build_showasm", _x2 - 290, _y1 + 12, "Show the 6502 code", build_show_asm, "6502 code|For the curious: shows the assembly language the studio wrote for you. You never need to edit it.");
+    var _lx1 = _rx + 14;
