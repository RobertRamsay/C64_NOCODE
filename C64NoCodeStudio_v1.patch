+        [3, 14, 0, 6, 0, 5, 0, 3],
+        [2, 40, 3, 30, 2, 6, 8, 6],
+        [0, 50, -2, 30, 0, 9, 6, 8],
+        [2, 90, 0, 3, 0, 3, 0, 2]
+    ];
+    var _v = _t[clamp(_p, 0, 7)];
+    _s.wave = _v[0];
+    _s.pitch = _v[1];
+    _s.sweep = _v[2];
+    _s.len = _v[3];
+    _s.atk = _v[4];
+    _s.dec = _v[5];
+    _s.sus = _v[6];
